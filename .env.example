# WS4Free environment configuration — copy to `.env` and fill in.
#   cp .env.example .env
# `.env` is gitignored and must never be committed. Values below are EXAMPLES;
# generate your own secrets. In production (DJANGO_DEBUG=False) the app refuses to
# start unless DJANGO_SECRET_KEY and DJANGO_ALLOWED_HOSTS are set.

# ── Core ──────────────────────────────────────────────────────────────────────
# 'prod' or 'dev'. Informational ('dev' adds a DEV badge); security keys off DJANGO_DEBUG.
DJANGO_ENVIRONMENT=prod

# Set False in production. When False, SECRET_KEY/ALLOWED_HOSTS become mandatory
# and the HTTPS redirect and secure cookies are enforced.
DJANGO_DEBUG=False

# REQUIRED in production. Generate a fresh value with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# In development you may leave this blank and a throwaway key is generated per run.
DJANGO_SECRET_KEY=

# REQUIRED in production. Comma-separated hostnames that serve the app.
DJANGO_ALLOWED_HOSTS=weather.example.com

# True (the default when DEBUG=False) redirects to HTTPS and sends cookies only over
# HTTPS. Set False ONLY for a home-network install reached over plain http://
# (passkeys also need HTTPS, except on localhost).
DJANGO_HTTPS=True

# Comma-separated https origins trusted for CSRF (proxied/HTTPS deployments).
DJANGO_CSRF_TRUSTED_ORIGINS=https://weather.example.com

# Absolute path for collectstatic output (blank = <project>/staticfiles).
DJANGO_STATIC_ROOT=

# Where the error log is written (blank = <project>/django_errors.log).
DJANGO_LOG_FILE=

# Time zone for the admin and logs. Station data is stored in UTC and shown in
# each station's own time zone, so this rarely matters.
TIME_ZONE=UTC

# ── Database ──────────────────────────────────────────────────────────────────
# mysql (reference deployment), postgresql, or sqlite.
# MySQL: load the time zone tables first — see README, "MySQL time zone tables".
# SQLite: DB_NAME is the database file path; the other DB_* values are ignored.
DB_ENGINE=mysql
DB_NAME=ws4free
DB_USER=ws4free
DB_PASSWORD=change-me-strong-db-password
DB_HOST=localhost
DB_PORT=3306

# ── Passkeys / WebAuthn ───────────────────────────────────────────────────────
# RP_ID is the bare domain (no scheme, no port). ALLOWED_ORIGINS is the full https
# origin(s). A mismatch makes passkey registration fail.
OTP_WEBAUTHN_RP_NAME=WS4Free
OTP_WEBAUTHN_RP_ID=weather.example.com
OTP_WEBAUTHN_ALLOWED_ORIGINS=https://weather.example.com

# ── Weather data ──────────────────────────────────────────────────────────────
# Ambient Weather REST API keys, from your account page on ambientweather.net.
# Used by the poller and the history backfill; leave blank if you only push.
AMBIENT_API_KEY=
AMBIENT_APPLICATION_KEY=

# Display units for visitors and new users: imperial or metric. Data is always
# stored in SI units; each user can change their own units in Settings.
DEFAULT_UNIT_SYSTEM=imperial

# Log every raw console upload to the admin (Ingest captures) — turn on while
# setting up a console, off afterwards. Captures are kept this many days.
INGEST_CAPTURE=False
INGEST_CAPTURE_RETENTION_DAYS=7

# Merge raw readings older than this many years into 15-minute buckets to save
# space. 0 (the default) keeps every raw reading forever.
RAW_RETENTION_YEARS=0

# Dashboard forecast from Open-Meteo (free, no key; sends each station's location rounded to ~1 km).
# Leave unset for the default; set it empty (FORECAST_URL=) to turn forecasts off for the whole site.
#FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Neighbouring stations (Station → Manage → Neighbours): compare your readings with
# nearby Weather Underground stations. WU gives free API keys to owners of stations
# that upload to it: https://www.wunderground.com/member/api-keys. Leave blank to
# turn the feature off. The free key allows 1,500 requests a day: each neighbour
# polled every WU_POLL_MINUTES uses 1440 / WU_POLL_MINUTES of them.
WU_API_KEY=
#WU_POLL_MINUTES=10
