# WS4Free Docker settings — copy to `.env` next to compose.yaml and fill in.
# Every variable from .env.example works here too; these are the ones Docker needs.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

# The names you'll use to reach WS4Free (hostname, LAN IP, or both).
DJANGO_ALLOWED_HOSTS=weather.example.com,192.168.1.50
DJANGO_CSRF_TRUSTED_ORIGINS=https://weather.example.com

# True behind an HTTPS reverse proxy (recommended). False if you only reach the
# site over plain http:// on your home network; sign-in won't work otherwise.
DJANGO_HTTPS=True

# Database passwords (the database itself is created for you).
DB_NAME=ws4free
DB_USER=ws4free
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Port on the host. Point your console's custom-server upload at this port.
WS4FREE_PORT=8000

# Station time zone for the scheduler's daily housekeeping (e.g. America/Denver).
TIME_ZONE=UTC

# Optional: Ambient Weather API keys (enables gap-filling and history import).
AMBIENT_API_KEY=
AMBIENT_APPLICATION_KEY=

DEFAULT_UNIT_SYSTEM=imperial

# Passkeys: the bare domain and full https origin users sign in on.
OTP_WEBAUTHN_RP_ID=weather.example.com
OTP_WEBAUTHN_ALLOWED_ORIGINS=https://weather.example.com
